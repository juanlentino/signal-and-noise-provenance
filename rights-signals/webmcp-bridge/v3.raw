    var fresh = !s;
    if (fresh) {
      s = doc.createElement("script");
      s.src = url;
      if (s.setAttribute) s.setAttribute("data-sn-prov-core", "pending");
    }
    if (s.addEventListener) {
      s.addEventListener("load", onLoad);
      s.addEventListener("error", onError);
    } else {
