function snWebmcpMain(w) {
  var win = w || (typeof window !== "undefined" ? window : null);
  var doc = win && win.document;
  if (!doc) return;
  if (win.__snWebmcpRegistered) return;
  var api = snAgentApi(win);
  if (!api) return;
